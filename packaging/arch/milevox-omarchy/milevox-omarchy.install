# shellcheck shell=bash

post_install() {
  cat <<'EOF'

==> Install the Milevox GUI for the current user:
      milevox-omarchy install

EOF
}

post_upgrade() {
  cat <<'EOF'

==> Update the Milevox GUI files for the current user:
      milevox-omarchy install

EOF
}

pre_remove() {
  cat <<'EOF'

==> Remove the Milevox GUI integration before removing this package:
      milevox-omarchy uninstall

    This preserves Milevox configuration, credentials, logs, and models.

EOF
}
