# shellcheck shell=bash

post_install() {
  cat <<'EOF'

==> Milevox installation

    Set up Milevox for each desktop user:
      milevox-setup

EOF
}

post_upgrade() {
  cat <<'EOF'

==> Restart Milevox to use the upgraded binary:
      systemctl --user restart milevox.service

EOF
}

pre_remove() {
  cat <<'EOF'

==> Disable Milevox before removing the package (as each desktop user):
      milevox-teardown

EOF
}
